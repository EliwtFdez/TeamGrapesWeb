# Public build-time settings. Values prefixed VITE_ are visible to visitors.
# Do not put passwords, API tokens, private keys, or mail-provider credentials here.
VITE_SITE_URL=https://team-grapes-studio.glassy-lamp-0223.chatgpt.site
# Leave blank until a GA4 property exists. Analytics also requires opt-in consent.
VITE_GA_MEASUREMENT_ID=
# Enable only during a dedicated DebugView session; keep false in production.
VITE_GA_DEBUG=false
# Optional full postal address for the privacy notice. Do not add a private address
# until the owner has selected the public address for receiving legal requests.
VITE_LEGAL_ADDRESS=
